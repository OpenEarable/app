<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Android Keystore keys do not survive restore on another device. -->
        <exclude domain="sharedpref" path="meditation_service_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:meditation_service_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:meditation_service_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="meditation_service_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:meditation_service_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:meditation_service_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
